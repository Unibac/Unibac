# Copia a .env.local (no versionar). Detalle: prisma/README.md

# --- Postgres (Supabase → Project Settings → Database) ---

# Pooler (puerto 6543, ?pgbouncer=true) — runtime Prisma en Route Handlers
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Conexión directa (puerto 5432) — Prisma CLI: migrate, pull, studio
DIRECT_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres"

# --- Supabase Auth (@supabase/ssr) — Project Settings → API ---

NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co

# Clave pública (anon o publishable; el código acepta cualquiera de las dos)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret / service_role — SOLO servidor (nunca NEXT_PUBLIC_). Login admin, registro, crear usuarios.
SUPABASE_SERVICE_ROLE_KEY=

# --- Registro público ---

# Servidor: POST /api/auth/register-public responde 403 si no está habilitado
PUBLIC_REGISTRATION_ENABLED=true

# Cliente: ocultar UI de registro si es "false" (default: habilitado)
# NEXT_PUBLIC_PUBLIC_REGISTRATION_ENABLED=false

# --- Traiker (uploads de imágenes) — sin barra final en base URL ---

TRAIKER_API_BASE_URL=https://api.traiker.com
TRAIKER_USR=
TRAIKER_PSW=

# --- Opcional ---

# Dominio del email interno para Supabase Auth (default: auth.unibac.local)
# AUTH_EMAIL_DOMAIN=auth.unibac.local

# Login del admin semilla (debe coincidir con seed/migraciones)
# SEED_ADMIN_USUARIO=administrador
