# Contrato: https://unibac-be-staging.up.railway.app/docs-json
# Swagger: https://unibac-be-staging.up.railway.app/docs

# --- Recomendado (frontend y API en dominios distintos, p. ej. Railway) ---
# Proxy same-origin: la cookie access_token queda en el dominio del frontend.
API_PROXY_TARGET=https://unibac-be-staging.up.railway.app
NEXT_PUBLIC_API_URL=/api-proxy

# --- Alternativa: API directo (cross-origin). El middleware no verá la cookie tras login. ---
# NEXT_PUBLIC_API_URL=https://unibac-be-staging.up.railway.app

# Mostrar enlace y ruta de registro público (`POST /auth/register-public`). Si es "false", se oculta el CTA en login y la página /register muestra aviso.
# NEXT_PUBLIC_PUBLIC_REGISTRATION_ENABLED=false
