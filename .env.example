# Supabase — copia a .env y rellena con valores del dashboard del proyecto.
# Prisma: ver prisma/README.md

# Pooler (Transaction mode, puerto 6543) — runtime (`src/lib/prisma.ts`)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Conexión directa (puerto 5432) — Prisma CLI (migrate, pull, studio)
DIRECT_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres"

# Cliente en el frontend (@supabase/ssr)
NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
